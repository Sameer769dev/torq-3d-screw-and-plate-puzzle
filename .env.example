# TORQ: 3D Screw & Plate Puzzle - Production AdMob Configuration
# Copy this file to `.env.local` and fill in your real AdMob Ad Unit IDs before publishing to Google Play.
# While VITE_ADMOB_TESTING is unset or "true", Google's official safe test ad unit IDs are used automatically.

VITE_ADMOB_TESTING=false
VITE_ADMOB_ANDROID_REWARDED=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
VITE_ADMOB_ANDROID_INTERSTITIAL=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ

# Also replace `com.google.android.gms.ads.APPLICATION_ID` in:
# android/app/src/main/AndroidManifest.xml
# with your real AdMob App ID (ca-app-pub-XXXXXXXXXXXXXXXX~AAAAAAAAAA).
